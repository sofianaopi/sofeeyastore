# Sofeeya Store POS — pengaturan server Apache/LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.html

# Paksa HTTPS — hapus tanda # di 5 baris berikut setelah SSL aktif di hPanel
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Halaman & data demo tidak dipakai di toko: tolak bila masih tersisa di server
<FilesMatch "^(demo\.html|demo\.php|demo-leads\.php)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/api/demo-data(/.*)?$

# Jangan izinkan file database/teks diunduh langsung
<FilesMatch "\.(sql|md|log|ini|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  # aplikasi kasir tidak diindeks; website katalog & fotonya boleh
  SetEnvIf Request_URI "^/(katalog|uploads/katalog)(/|$)" PUBLIC_WEB
  Header always set X-Robots-Tag "noindex, nofollow" env=!PUBLIC_WEB
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Aplikasi (PWA): service worker & manifest jangan di-cache lama
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
